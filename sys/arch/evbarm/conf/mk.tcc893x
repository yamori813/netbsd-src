#	$NetBSD: mk.bcm53xx,v 1.6 2019/01/21 07:26:14 skrll Exp $
CPPFLAGS+= -mcpu=cortex-a9 -mfpu=neon

.if !empty(MACHINE_ARCH:M*eb)
EXTRA_LINKFLAGS+=	--be8
.endif

SYSTEM_FIRST_OBJ=	armv6_start.o
SYSTEM_FIRST_SFILE=	${ARM}/arm/armv6_start.S

_OSRELEASE!=		${HOST_SH} $S/conf/osrelease.sh

TOOL_MKBOOTIMG=		mkbootimg
MKBOOTIMGARGS=		--base 0x80000000 --kernel_offset 0x8000

.if !defined(KERNEL_BASE_PHYS)
KERNEL_BASE_PHYS=$(LOADADDRESS)
.endif
.if !defined(KERNEL_BASE_VIRT)
KERNEL_BASE_VIRT=$(LOADADDRESS)
.endif

SYSTEM_LD_TAIL_EXTRA+=; \
	echo ${OBJCOPY} -S -O binary $@ $@.bin; \
	${OBJCOPY} -S -O binary $@ $@.bin; \
	echo ${TOOL_MKUBOOTIMAGE} ${MKUBOOTIMAGEARGS_NONE} $@.bin $@.ub; \
	${TOOL_MKBOOTIMG} --kernel $@.bin ${MKBOOTIMGARGS} -o $@.img; \
	echo

EXTRA_KERNELS+= ${KERNELS:@.KERNEL.@${.KERNEL.}.bin@}
EXTRA_KERNELS+= ${KERNELS:@.KERNEL.@${.KERNEL.}.img@}
