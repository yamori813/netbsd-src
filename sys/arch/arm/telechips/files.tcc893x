#	$NetBSD$
#
# Configuration info for Telechips TCC893X ARM Peripherals
#

include "arch/arm/pic/files.pic"
include "arch/arm/cortex/files.cortex"

file	arch/arm/arm32/arm32_boot.c
file	arch/arm/arm32/arm32_kvminit.c
file	arch/arm/arm32/arm32_reboot.c
file	arch/arm/arm32/irq_dispatch.S

define	bus_dma_generic
file	arch/arm/arm32/armv7_generic_space.c
#file	arch/arm/arm/arm_generic_dma.c          bus_dma_generic needs-flag
file	arch/arm/arm/arm_generic_dma.c
file	arch/arm/arm/bus_space_a4x.S

file	arch/arm/telechips/tcc893x_board.c

defparam opt_tcc893x.h				MEMSIZE

# tcc893x AXI/AHB bus interface and SoC domains
device	axi { [addr=-1], [size=0], [intr=-1], [irqbase=-1]} : bus_space_generic
attach	axi at mainbus
file	arch/arm/telechips/tcc893x_axi.c		axi

attach	com at axi with tcc893x_com
file	arch/arm/telechips/tcc893x_com.c		tcc893x_com

device	ckc
attach	ckc at axi
file	arch/arm/telechips/tcc893x_ckc.c		ckc		needs-flag

# GPIO
device  tcc893x_gpio: gpiobus
attach  tcc893x_gpio at axi
file    arch/arm/telechips/tcc893x_gpio.c		tcc893x_gpio	needs-flag

# Timer/Counter
device  tcc893x_timer
attach  tcc893x_timer at axi
file    arch/arm/telechips/tcc893x_timer.c		tcc893x_timer	needs-flag

# PMU(Power Management Unit)
device  tcc893x_pmu
attach  tcc893x_pmu at axi
file    arch/arm/telechips/tcc893x_pmu.c		tcc893x_pmu	needs-flag

# VPIC
device  tcc893x_pic
attach  tcc893x_pic at axi
file    arch/arm/telechips/tcc893x_pic.c		tcc893x_pic	needs-flag

# Ethernet
attach	awge at axi with tcc893x_gmac
file	arch/arm/telechips/tcc893x_gmac.c		tcc893x_gmac

# USB3 Host Controller (XHCI)
attach xhci at axi with xhci_axi
file    arch/arm/telechips/tcc893x_xhci.c        	xhci_axi

# USB2 OTG
attach	dwctwo at axi with tcc893x_otg
file	arch/arm/telechips/tcc893x_otg.c		tcc893x_otg

# UHCI USB1.1 Controller
attach	ohci at axi with tcc893x_ohci
file    arch/arm/telechips/tcc893x_ohci.c		tcc893x_ohci

# EHCI USB2.0 Controller
attach	ehci at axi with tcc893x_ehci
file	arch/arm/telechips/tcc893x_ehci.c		tcc893x_ehci

